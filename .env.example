# Anthropic（後台的藍圖對話與抽藍圖）
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 平台的正式網址，用來產生上傳頁連結；Vercel 上沒設定時用 VERCEL_PROJECT_PRODUCTION_URL
PLATFORM_BASE_URL=

# 雲端後備產檔（src/lib/claude/generate-artifact.ts）才需要；主路徑是講師自己的 Claude Code，可留空
ANTHROPIC_SKILL_ID_BRAND_GUIDELINES=
ANTHROPIC_SKILL_ID_PPTX_WORKFLOW=
